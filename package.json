{
  "name": "pta-c-checker",
  "version": "1.0.0",
  "private": true,
  "description": "纯前端 C 语言基础题代码检查器：指出错误位置/原因/改法，并可本地运行对比输出。",
  "scripts": {
    "serve": "node tools/serve.mjs",
    "build:engine": "node tools/build-jscpp.mjs",
    "verify:analyzer": "node tools/test-analyzer.mjs && node tools/test-analyzer2.mjs",
    "verify:engine": "node tools/conformance.mjs",
    "verify:problems": "node tools/verify-problems.mjs",
    "verify:ui": "node tools/test-ui.mjs",
    "verify:localai": "node tools/test-localai.mjs",
    "test": "npm run verify:analyzer && npm run verify:engine && npm run verify:problems && npm run verify:localai && npm run verify:ui"
  },
  "dependencies": {
    "JSCPP": "^2.0.9"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
